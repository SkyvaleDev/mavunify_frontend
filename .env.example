# WeatherAPI.com backup key (optional).
# Get a free key at https://www.weatherapi.com/my/ → Dashboard → API keys.
# Copy this file to .env.local and fill in your key:
#   cp .env.example .env.local
# When set, WeatherAPI.com is used as the first backup if Open-Meteo fails.
# When unset, wttr.in (no key required) is used as the backup instead.
VITE_WEATHERAPI_KEY=
